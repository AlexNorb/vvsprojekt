---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import { siteConfig } from "../config";

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const { title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL;

// SEO defaults
const siteTitle = siteConfig.brandName;
const fullTitle = `${title} | ${siteTitle}`;
const defaultDescription = siteConfig.seo.defaultDescription;
const metaDescription = description || defaultDescription;
const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || siteConfig.domain,
);
const ogImage = image || `${base}images/og-image.jpeg`;

// LocalBusiness structured data for local SEO
const localBusinessSchema = {
    "@context": "https://schema.org",
    "@type": siteConfig.schema.type,
    name: siteConfig.brandName,
    description: defaultDescription,
    url: siteConfig.domain,
    telephone: siteConfig.phone.display,
    email: siteConfig.email.display,
    areaServed: siteConfig.serviceAreas.map(area => ({ "@type": "City", name: area })),
    serviceType: siteConfig.schema.serviceTypes,
    priceRange: siteConfig.schema.priceRange,
};
---

<!doctype html>
<html lang="sv" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{fullTitle}</title>
        <meta name="description" content={metaDescription} />
        <ViewTransitions />

        <!-- Canonical URL & Language -->
        <link rel="canonical" href={canonicalURL.toString()} />
        <link rel="alternate" hreflang="sv-SE" href={canonicalURL.toString()} />
        <link
            rel="alternate"
            hreflang="x-default"
            href={canonicalURL.toString()}
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.toString()} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={fullTitle} />
        <meta property="og:locale" content="sv_SE" />
        <meta property="og:site_name" content={siteTitle} />

        <meta name="theme-color" content="#ffffff" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Additional SEO -->
        <meta name="robots" content="index, follow" />
        <meta name="author" content={siteConfig.brandName} />
        <meta name="geo.region" content={siteConfig.seo.geoRegion} />
        <meta name="geo.placename" content={siteConfig.seo.geoPlacename} />

        <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />

        <!-- Preload Bank Gothic Light for faster loading -->
        <link
            rel="preload"
            href={base + "fonts/bank-gothic-light.woff2"}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <!-- Google Fonts: Inter -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Structured Data (JSON-LD) -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(localBusinessSchema)}
        />
    </head>
    <body
        class="font-sans text-slate-700 antialiased bg-slate-50 selection:bg-vvsblue selection:text-white overflow-x-hidden"
    >
        <slot />
    </body>
</html>
