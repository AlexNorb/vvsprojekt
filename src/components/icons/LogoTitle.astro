---
import { Image } from "astro:assets";
import fullLogo from "../../assets/logo/full_logo.svg";

interface Props {
    className?: string;
    light?: boolean;
}
const { className = "", light = false } = Astro.props;
---

<Image
    src={fullLogo}
    alt="VVS PROJEKT - Ditt projekt i fokus"
    class:list={["h-auto w-auto block", className, light ? "brightness-0 invert" : ""]}
    loading="eager"
/>
