---
import { Image } from "astro:assets";
import fullLogo from "../../assets/logo/full_logo.svg";

interface Props {
    className?: string;
    light?: boolean;
}
const { className = "", light = false } = Astro.props;
---

<a href="/" class:list={["inline-flex items-center gap-2 group", className]}>
    <Image
        src={fullLogo}
        alt="VVS PROJEKT - Ditt projekt i fokus"
        class:list={["h-auto w-auto", className, light ? "brightness-0 invert" : ""]}
    />
</a>
