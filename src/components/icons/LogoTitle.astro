---
interface Props {
    className?: string;
    light?: boolean;
}
const { className = "", light = false } = Astro.props;
---

<a href="/" class:list={["inline-flex items-center gap-2 group", className]}>
    <svg
        viewBox="0 0 280 50"
        xmlns="http://www.w3.org/2000/svg"
        class:list={["h-full w-auto", className]}
        aria-label="VVS PROJEKT"
    >
        {/* Brand name */}
        <text
            x="0"
            y="30"
            font-family="'Bank Gothic Light', sans-serif"
            font-weight="300"
            font-size="28"
            letter-spacing="2"
            fill={light ? "#ffffff" : "#003ca6"}
        >
            VVS PROJEKT
        </text>

        {/* Tagline */}
        <text
            x="0"
            y="46"
            font-family="'Bank Gothic Light', sans-serif"
            font-weight="300"
            font-size="9"
            letter-spacing="4"
            fill={light ? "#c17f59" : "#c17f59"}
        >
            DITT PROJEKT I FOKUS
        </text>

        {/* Accent line */}
        <line
            x1="0"
            y1="34"
            x2="220"
            y2="34"
            stroke={light ? "rgba(193,127,89,0.4)" : "rgba(193,127,89,0.3)"}
            stroke-width="0.5"
        />
    </svg>
</a>
