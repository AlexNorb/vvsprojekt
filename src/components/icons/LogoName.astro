---
import { Image } from "astro:assets";
import fullLogo from "../../assets/logo/full_logo.svg";

interface Props {
    className?: string;
    light?: boolean;
}
const { className = "", light = false } = Astro.props;
---

<Image
    src={fullLogo}
    alt="VVS PROJEKT"
    class:list={["block object-contain", className, light ? "brightness-0 invert" : ""]}
/>
