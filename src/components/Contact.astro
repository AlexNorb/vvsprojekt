---
import PhoneIcon from "./icons/PhoneIcon.astro";
import EnvelopeIcon from "./icons/EnvelopeIcon.astro";
import ContactForm from "./ContactForm.astro";
import { siteConfig } from "../config";
---

<section id="contact" class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2
                class="text-vvscopper font-bold tracking-wide uppercase text-sm mb-2 font-display"
            >
                Kontakta Oss
            </h2>
            <h3
                class="text-3xl font-extrabold text-slate-900 sm:text-4xl font-display"
            >
                Hör av dig direkt
            </h3>
            <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
                Kontakta oss gärna per telefon för snabbast återkoppling. Vid offertförfrågningar och projekteringsunderlag rekommenderar vi formuläret eller e-post, där ni även har möjlighet att bifoga ritningar och specifikationer.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
            {/* Contact Info - Top Left on Desktop */}
            <div class="flex flex-col justify-center space-y-8 lg:col-start-1">
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4"
                >
                    <a
                        href={siteConfig.phone.href}
                        class="block p-6 bg-white rounded-lg shadow-sm border border-slate-100 hover:border-vvsblue hover:shadow-md transition-all group text-center"
                    >
                        <div class="flex items-center justify-center mb-2">
                            <div
                                class="flex-shrink-0 bg-vvsblue-50 p-2 rounded-full group-hover:bg-vvsblue group-hover:text-white text-vvsblue transition-colors mr-3"
                            >
                                <PhoneIcon className="h-5 w-5" />
                            </div>
                            <p
                                class="text-sm font-medium text-slate-500 uppercase tracking-wide"
                            >
                                Ring oss
                            </p>
                        </div>
                        <p
                            class="text-xl font-bold text-slate-900 font-display"
                        >
                            {siteConfig.phone.display}
                        </p>
                    </a>

                    <a
                        href={siteConfig.email.href}
                        class="block p-6 bg-white rounded-lg shadow-sm border border-slate-100 hover:border-vvsblue hover:shadow-md transition-all group text-center"
                    >
                        <div class="flex items-center justify-center mb-2">
                            <div
                                class="flex-shrink-0 bg-vvsblue-50 p-2 rounded-full group-hover:bg-vvsblue group-hover:text-white text-vvsblue transition-colors mr-3"
                            >
                                <EnvelopeIcon className="h-5 w-5" />
                            </div>
                            <p
                                class="text-sm font-medium text-slate-500 uppercase tracking-wide"
                            >
                                Kontakta via e-post
                            </p>
                        </div>
                        <p
                            class="text-xl font-bold text-slate-900 font-display"
                        >
                            {siteConfig.email.display}
                        </p>
                    </a>
                </div>

                <div>
                    <h4
                        class="text-xl font-bold font-display text-slate-900 mb-4"
                    >
                        Ert projekt i fokus
                    </h4>
                    <p class="text-slate-600 text-base">
                        Vi erbjuder noggrann rådgivning och behovsanalys anpassad efter era förutsättningar. Vid mer omfattande installationer och entreprenader bokar vi gärna ett platsbesök för att gå igenom tekniska lösningar och tidsramar.
                    </p>
                </div>
            </div>

            {
                /* Form - Right Column */
            }
            <div
                id="contact-form"
                class="bg-white rounded-lg shadow-xl p-8 sm:p-12 border border-slate-100"
            >
                <ContactForm />
            </div>
        </div>
    </div>
</section>
