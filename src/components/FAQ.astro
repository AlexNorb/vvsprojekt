---
import ChevronDownIcon from "./icons/ChevronDownIcon.astro";

const faqs = [
    {
        question: "Vad är ROT-avdraget för VVS-arbeten?",
        answer: "ROT-avdraget ger privatpersoner 30% skattereduktion på arbetskostnaden vid VVS-installationer i bostaden, exempelvis vid badrumsrenovering, byte av värmepump eller rördragning. Vi administrerar avdraget direkt på fakturan för en smidig hantering.",
    },
    {
        question: "Hur snabbt kan ni bistå vid akuta ärenden?",
        answer: "Vi prioriterar akuta ärenden såsom vattenläckor och strävar efter snabbast möjliga inställelsetid. Kontakta oss direkt per telefon för omedelbar rådgivning och åtgärd.",
    },
    {
        question: "Vad kostar en värmepumpsinstallation?",
        answer: "Investeringskostnaden beror på fastighetens energibehov och val av värmepumpslösning (t.ex. bergvärme eller luft/vatten). Kontakta oss för en teknisk genomgång och en specificerad offert anpassad efter era förutsättningar.",
    },
    {
        question: "Vilka typer av uppdrag åtar ni er?",
        answer: "Vi är specialiserade på kompletta VVS-installationer i villor, fritidshus och lägenheter – med särskilt fokus på värmepumpar, badrums- och köksrenoveringar samt vattenburen värme. Kontakta oss för att diskutera ert projekt.",
    },
];
---

<section id="faq" class="py-16 bg-white relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2
                class="text-vvscopper font-bold tracking-wide uppercase text-sm mb-2 font-display"
            >
                Vanliga Frågor
            </h2>
            <h3
                class="text-3xl font-extrabold text-slate-900 sm:text-4xl font-display"
            >
                Du undrar, vi svarar.
            </h3>
        </div>

        <div class="space-y-4">
            {
                faqs.map((faq, index) => (
                    <div class="faq-item border border-slate-100 rounded-lg overflow-hidden transition-all duration-300 bg-white hover:border-vvsblue/30">
                        <button class="faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
                            <span class="faq-question font-display font-bold text-lg transition-colors text-slate-800">
                                {faq.question}
                            </span>
                            <span class="faq-icon ml-6 flex-shrink-0 transition-transform duration-300 text-slate-400">
                                <ChevronDownIcon className="w-6 h-6" />
                            </span>
                        </button>

                        <div class="faq-answer px-6 text-slate-600 overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0">
                            <p class="leading-relaxed border-t border-slate-200/50 pt-4 pb-6">
                                {faq.answer}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const toggles = document.querySelectorAll(".faq-toggle");

        toggles.forEach((toggle) => {
            toggle.addEventListener("click", () => {
                const parent = toggle.parentElement;
                const answer = parent?.querySelector(".faq-answer") as HTMLElement;
                const icon = toggle.querySelector(".faq-icon");
                const question = toggle.querySelector(".faq-question");

                if (!answer || !parent || !icon || !question) return;

                const isClosed = answer.classList.contains("max-h-0");

                // Close all others
                document.querySelectorAll(".faq-item").forEach((item) => {
                    const ans = item.querySelector(".faq-answer") as HTMLElement;
                    const icn = item.querySelector(".faq-icon");
                    const qst = item.querySelector(".faq-question");

                    if (ans) {
                        ans.style.maxHeight = "0px";
                        ans.classList.add("max-h-0", "opacity-0");
                    }
                    icn?.classList.remove("rotate-180", "text-vvsblue");
                    qst?.classList.remove("text-vvsblue");
                    item.classList.remove(
                        "shadow-lg",
                        "bg-slate-50",
                        "border-vvsblue/20",
                    );
                });

                if (isClosed) {
                    answer.classList.remove("max-h-0", "opacity-0");
                    answer.style.maxHeight = answer.scrollHeight + "px";

                    icon.classList.add("rotate-180", "text-vvsblue");
                    question.classList.add("text-vvsblue");
                    parent.classList.add(
                        "shadow-lg",
                        "bg-slate-50",
                        "border-vvsblue/20",
                    );
                }
            });
        });
    });
</script>
